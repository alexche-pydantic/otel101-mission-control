# Copy to .env and fill in. Both keys are required for the live demo.
OPENAI_API_KEY=sk-...
LOGFIRE_TOKEN=pylf_v1_...

# Defaults are fine. Two different models is the point of the last demo beat.
MODEL_AGENT=openai:gpt-4.1
MODEL_ANALYST=openai:gpt-4.1-mini
GROUND_STATION_URL=http://localhost:8011

# STEP 5 (live): set this to 1 and restart the ground station to trace its side too.
# GROUND_STATION_TELEMETRY=1
