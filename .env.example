# Copy to .env and fill in.

# Option A — Pydantic AI Gateway (one key, spend limits, managed in Logfire).
# Generate the key in the Logfire dashboard; it must encode a region.
PYDANTIC_AI_GATEWAY_API_KEY=
MODEL_AGENT=gateway/openai:gpt-4.1
MODEL_ANALYST=gateway/openai:gpt-4.1-mini

# Option B — straight to OpenAI. Drop the "gateway/" prefix above and set:
# OPENAI_API_KEY=sk-...

# Leave LOGFIRE_TOKEN unset to use your `logfire auth` credentials.
# A placeholder value here will override them and 401.
# LOGFIRE_TOKEN=
GROUND_STATION_URL=http://localhost:8011
# Names the agent's spans in Logfire. Without it they land as "unknown_service",
# which reads badly in the cross-service beat. Kept here so the STEP 2 paste stays
# a bare logfire.configure().
LOGFIRE_SERVICE_NAME=mission-control


# STEP 5 (live): set this to 1 and restart the ground station to trace its side too.
# GROUND_STATION_TELEMETRY=1
